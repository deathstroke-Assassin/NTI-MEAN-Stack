<%- include('../../dashboard/partials/headerLayout.ejs', {
    pageName: "Dishes Page",
    pathLevel: "/"
}) %>

<div class="container-fluid pt-4 px-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="mb-1">Newly created Products</h3>
            <p class="text-muted mb-0">Manage your dishes and products</p>
        </div>

        <a href="/products/createForm" class="btn btn-primary">
            <i class="fa fa-plus me-2"></i>
            Create New Product
        </a>
    </div>


    <% if(CreatedProducts.length > 0) { %>

        <!-- Products Table -->
        <div class="bg-light rounded p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Weight</th>
                            <th scope="col" class="text-center">Operations</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% CreatedProducts.forEach((oneProduct, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>
                                    <strong>
                                        <%= oneProduct.productName %>
                                    </strong>
                                </td>

                                <td>
                                    <%= oneProduct.weight %>
                                </td>

                                <td class="text-center">

                                 

                                    <a href="/dashboard/productAproval/accept/<%= oneProduct._id %>"
                                       class="btn btn-sm btn-warning me-1">
                                        <i class="fa fa-edit me-1"></i>
                                        Accept
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="destroy(this)"
                                            productID="<%= oneProduct._id %>">
                                        <i class="fa fa-trash me-1"></i>
                                        Reject and Delete
                                    </button>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    <% } else { %>

        <!-- Empty State -->
        <div class="bg-light rounded p-5 text-center">

            <i class="fa fa-utensils fa-3x text-primary mb-3"></i>

            <h4>No Products Yet</h4>

            <p class="text-muted">
                You haven't created any products yet.
            </p>

            <a href="/products/createForm" class="btn btn-primary">
                <i class="fa fa-plus me-2"></i>
                Create Your First Product
            </a>

        </div>

    <% } %>

</div>


<!-- Update -->
 
<div class="container-fluid pt-4 px-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="mb-1">Products Marked for Update</h3>
            <p class="text-muted mb-0">Manage your dishes and products</p>
        </div>

       
    </div>


    <% if(markedUpdateProducts.length > 0) { %>

        <!-- Products Table -->
        <div class="bg-light rounded p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Weight</th>
                            <th scope="col" class="text-center">Operations</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% markedUpdateProducts.forEach((oneProduct, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>
                                    <strong>
                                        <%= oneProduct.productName %>
                                    </strong>
                                </td>

                                <td>
                                    <%= oneProduct.weight %>
                                </td>

                                <td class="text-center">

                                 

                                    <a href="/dashboard/productAproval/update/<%= oneProduct._id %>"
                                       class="btn btn-sm btn-warning me-1">
                                        <i class="fa fa-edit me-1"></i>
                                        Update
                                    </a>

                                    <a href="/dashboard/productAproval/rejectupdate/<%= oneProduct._id %>"
                                       class="btn btn-sm btn-warning me-1">
                                        <i class="fa fa-edit me-1"></i>
                                        reject
                                    </a>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    <% } else { %>

        <!-- Empty State -->
        <div class="bg-light rounded p-5 text-center">

            <i class="fa fa-utensils fa-3x text-primary mb-3"></i>

            <h4>No Products Yet</h4>

            <p class="text-muted">
                You haven't created any products yet.
            </p>

          

        </div>

    <% } %>

</div>

<!-- delete -->

<div class="container-fluid pt-4 px-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="mb-1">Products Marked for Deletion</h3>
            <p class="text-muted mb-0">Manage your dishes and products</p>
        </div>

    </div>


    <% if(markedDeleteProducts.length > 0) { %>

        <!-- Products Table -->
        <div class="bg-light rounded p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Weight</th>
                            <th scope="col" class="text-center">Operations</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% markedDeleteProducts.forEach((oneProduct, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>
                                    <strong>
                                        <%= oneProduct.productName %>
                                    </strong>
                                </td>

                                <td>
                                    <%= oneProduct.weight %>
                                </td>

                                <td class="text-center">
                                    <a href="/dashboard/productAproval/rejectdelete/<%= oneProduct._id %>"
                                       class="btn btn-sm btn-warning me-1">
                                        <i class="fa fa-edit me-1"></i>
                                        Reject
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="destroy(this)"
                                            productID="<%= oneProduct._id %>">
                                        <i class="fa fa-trash me-1"></i>
                                        Accept DELETION
                                    </button>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    <% } else { %>

        <!-- Empty State -->
        <div class="bg-light rounded p-5 text-center">

            <i class="fa fa-utensils fa-3x text-primary mb-3"></i>

            <h4>No Products Yet</h4>

            <p class="text-muted">
                You haven't created any products yet.
            </p>

            <a href="/products/createForm" class="btn btn-primary">
                <i class="fa fa-plus me-2"></i>
                Create Your First Product
            </a>

        </div>

    <% } %>

</div>


<script>

    function destroy(obj) {

        if (confirm("Are You Sure you want to Delete this Product?")) {

            let id = obj.getAttribute("productID");

            window.location.replace("/products/destroy/" + id);

        }

    }


</script>


<%- include('../../dashboard/partials/footerLayout.ejs', {
    pathLevel: "/"
}) %>