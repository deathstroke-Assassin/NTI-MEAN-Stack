<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Reservation</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        :root {
            --coffee-dark: #38251d;
            --coffee: #6f4e37;
            --coffee-light: #a67b5b;
            --caramel: #c49a6c;
            --cream: #f8f3eb;
            --cream-dark: #eee3d5;
            --white: #fffdf9;
            --muted: #8b7a6d;
        }

        body {
            background: var(--cream);
            color: var(--coffee-dark);
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: var(--coffee-dark);
        }

        .navbar-brand {
            color: var(--cream) !important;
            font-weight: bold;
        }

        .page-container {
            max-width: 760px;
            margin: 50px auto;
            padding: 0 18px;
        }

        .reservation-card {
            background: var(--white);
            border: 1px solid var(--cream-dark);
            border-radius: 18px;
            padding: 32px;
            box-shadow: 0 8px 25px rgba(56, 37, 29, 0.08);
        }

        .page-title {
            font-weight: 700;
            color: var(--coffee-dark);
        }

        .room-badge {
            background: var(--cream);
            border: 1px solid var(--cream-dark);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: var(--coffee);
        }

        .form-control {
            padding: 12px;
            border-color: var(--cream-dark);
            border-radius: 9px;
        }

        .form-control:focus {
            border-color: var(--coffee-light);
            box-shadow: 0 0 0 0.2rem rgba(166, 123, 91, 0.18);
        }

        .btn-coffee {
            background: var(--coffee);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 9px;
        }

        .btn-coffee:hover {
            background: var(--coffee-dark);
            color: white;
        }

        .btn-back {
            color: var(--coffee);
            text-decoration: none;
            font-weight: 600;
        }

        .btn-back:hover {
            color: var(--coffee-dark);
        }

        .help-text {
            color: var(--muted);
            font-size: 0.85rem;
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="/rooms">
                Hotel Management
            </a>
        </div>
    </nav>

    <main class="page-container">
        <div class="reservation-card">

            <div class="mb-4">
                <a href="/reservations" class="btn-back">
                    &larr; Back to availability
                </a>

                <h1 class="page-title mt-3">Create Reservation</h1>

                <p class="text-secondary">
                    Enter the client's information to reserve this room.
                </p>
            </div>

            <div class="room-badge">
                <div class="text-secondary small">Selected Room</div>

                <h4 class="mb-1">
                    Room <%= room.roomName %>
                </h4>

                <div class="text-secondary small">
                    Check-in: <%= start %>
                    <span class="mx-2">|</span>
                    Check-out: <%= end %>
                </div>
            </div>

            <form action="/reservations/store" method="POST">

                <input
                    type="hidden"
                    name="roomId"
                    value="<%= room._id %>"
                >

                <div class="mb-3">
                    <label for="clientName" class="form-label">
                        Client Name
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="clientName"
                        name="clientName"
                        placeholder="Enter client's full name"
                        maxlength="100"
                        required
                    >
                </div>
<div class="mb-3">
    <label class="form-label">Price per day</label>

    <input
        type="text"
        class="form-control"
        value="<%= dailyPrice %> EGP"
        readonly
    >
</div>

<div class="mb-3">
    <label class="form-label">Total Price</label>

    <input
        type="text"
        class="form-control"
        id="totalPrice"
        value="<%= dailyPrice * (
            (new Date(end + 'T00:00:00Z') -
            new Date(start + 'T00:00:00Z')) / 86400000
        ) %> EGP"
        readonly
    >
</div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                      
                        <input
                            type="date"
                            class="form-control"
                            id="start"
                            name="start"
                            value="<%= start %>"
                            required
                            hidden
                        >
                    </div>

                    <div class="col-md-6 mb-3">
                    
                        <input
                            type="date"
                            class="form-control"
                            id="end"
                            name="end"
                            value="<%= end %>"
                            required
                            hidden

                        >
                    </div>
                </div>

                <p class="help-text mb-4">
                    New reservations will initially have a pending status.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <button type="submit" class="btn btn-coffee">
                        Create Reservation
                    </button>

                    <a href="/rooms" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </main>

    <script>
        const startInput = document.getElementById("start");
        const endInput = document.getElementById("end");

        startInput.addEventListener("change", () => {
            endInput.min = startInput.value;

            if (endInput.value && endInput.value <= startInput.value) {
                endInput.value = "";
            }
        });

        endInput.addEventListener("change", () => {
            if (startInput.value && endInput.value <= startInput.value) {
                endInput.setCustomValidity(
                    "Check-out must be after check-in."
                );
            } else {
                endInput.setCustomValidity("");
            }
        });
    </script>
</body>
</html>