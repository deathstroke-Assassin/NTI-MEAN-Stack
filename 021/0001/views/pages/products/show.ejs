<%- include('../../dashboard/partials/headerLayout.ejs', {
    pageName: "Product Details",
    pathLevel: "/"
}) %>

<div class="container-fluid pt-4 px-4">

    <% if(oneProduct.length > 0) { %>

        <div class="row justify-content-center">

            <div class="col-12 col-lg-8">

                <div class="bg-light rounded p-4">

                    <!-- Header -->
                    <div class="d-flex align-items-center justify-content-between mb-4">

                        <div>
                            <h3 class="mb-1">Product Details</h3>
                            <p class="text-muted mb-0">
                                Information about this product
                            </p>
                        </div>

                        <!-- <a href="/products/updateForm/<%= oneProduct[0]._id %>"
                           class="btn btn-warning">
                            <i class="fa fa-edit me-2"></i>
                            Update
                        </a> -->

                    </div>


                    <!-- Product -->
                    <div class="row align-items-center">

                        <!-- Product Image -->
                        <div class="col-md-5 text-center mb-4 mb-md-0">

                            <img src="/img/uploades/<%= oneProduct[0].photo %>"
                                 class="img-fluid rounded"
                                 style="max-height: 300px; object-fit: cover;"
                                 alt="<%= oneProduct[0].productName %>">

                        </div>


                        <!-- Product Information -->
                        <div class="col-md-7">

                            <div class="mb-4">

                                <label class="text-muted small">
                                    Product Name
                                </label>

                                <h4 class="mb-0">
                                    <%= oneProduct[0].productName %>
                                </h4>

                            </div>


                            <div class="mb-4">

                                <label class="text-muted small">
                                    Product Weight
                                </label>

                                <h5 class="mb-0">
                                    <%= oneProduct[0].weight %>
                                </h5>

                            </div>


                            <div class="d-flex gap-2">

                                <a href="/products"
                                   class="btn btn-secondary">
                                    <i class="fa fa-arrow-left me-2"></i>
                                    Back
                                </a>

                                <a href="/products/updateForm/<%= oneProduct[0]._id %>"
                                   class="btn btn-warning">
                                    <i class="fa fa-edit me-2"></i>
                                    Update
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    <% } else { %>

        <!-- No Product -->
        <div class="bg-light rounded p-5 text-center">

            <i class="fa fa-exclamation-circle fa-3x text-warning mb-3"></i>

            <h4>Product Not Found</h4>

            <p class="text-muted">
                No product with this information.
            </p>

            <a href="/products" class="btn btn-primary">
                <i class="fa fa-arrow-left me-2"></i>
                Back to Products
            </a>

        </div>

    <% } %>

</div>

<%- include('../../dashboard/partials/footerLayout.ejs', {
    pathLevel: "/"
}) %>