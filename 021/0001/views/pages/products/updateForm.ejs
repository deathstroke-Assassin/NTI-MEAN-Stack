<%- include('../../dashboard/partials/headerLayout.ejs', {
    pageName: "Edit Product",
    pathLevel: "/"
}) %>

<div class="container-fluid pt-4 px-4">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9">

            <div class="bg-light rounded p-4">

                <!-- Header -->
                <div class="mb-4">
                    <h3 class="mb-1">Edit Product</h3>
                    <p class="text-muted mb-0">
                        Update the product information or replace its photo.
                    </p>
                </div>

                <div class="row align-items-center">

                    <!-- Form -->
                    <div class="col-md-6">

                        <form action="../update"
                              method="post"
                              enctype="multipart/form-data">

                            <!-- Product Name -->
                            <div class="mb-3">
                                <label for="productName" class="form-label">
                                    Product Name
                                </label>

                                <input type="text"
                                       name="productName"
                                       id="productName"
                                       class="form-control"
                                       value="<%= oneProduct[0].productName %>"
                                       required>
                            </div>


                            <!-- Weight -->
                            <div class="mb-3">
                                <label for="weight" class="form-label">
                                    Weight
                                </label>

                                <input type="number"
                                       name="weight"
                                       id="weight"
                                       class="form-control"
                                       value="<%= oneProduct[0].weight %>"
                                       required>
                            </div>


                            <!-- Photo -->
                            <div class="mb-4">
                                <label for="photo" class="form-label">
                                    Product Photo
                                </label>

                                <input type="file"
                                       name="photo"
                                       id="photo"
                                       class="form-control"
                                       accept="image/*"
                                       onchange="photoPreviewFn(this);">

                                <small class="text-muted">
                                    Leave empty to keep the current photo.
                                </small>
                            </div>


                            <!-- Hidden ID -->
                            <input type="hidden"
                                   name="id"
                                   value="<%= oneProduct[0]._id %>">


                            <!-- Buttons -->
                            <button type="submit"
                                    class="btn btn-primary py-2 px-4">
                                <i class="fa fa-save me-2"></i>
                                Update Product
                            </button>

                            <a href="/products"
                               class="btn btn-secondary py-2 px-4 ms-2">
                                Cancel
                            </a>

                        </form>

                    </div>


                    <!-- Photo Preview -->
                    <div class="col-md-6 mt-4 mt-md-0">

                        <div class="text-center">

                            <h6 class="mb-3">
                                Product Photo
                            </h6>

                            <div class="border rounded p-3 bg-white">

                                <img src="/img/uploades/<%= oneProduct[0].photo %>"
                                     id="photoPreview"
                                     class="img-fluid rounded"
                                     alt="Product Photo"
                                     style="max-height: 300px;">

                                <p class="text-muted mt-3 mb-0">
                                    Select a new image above to replace the current photo.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    function photoPreviewFn(inputFile) {

        var file = inputFile.files[0];

        if (file) {

            var reader = new FileReader();

            reader.onload = () => {

                document
                    .getElementById("photoPreview")
                    .setAttribute("src", reader.result);

            };

            reader.readAsDataURL(file);
        }
    }

</script>


<%- include('../../dashboard/partials/footerLayout.ejs', {
    pathLevel: "/"
}) %>
