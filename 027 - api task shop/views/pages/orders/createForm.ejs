<%- include('../../partials/siteHeader', {pageTitle: 'Enter order'}) %>

<section>
    <div class="page-heading"><p class="text-uppercase text-secondary small fw-semibold mb-1">Order management</p><h1 class="h2 mb-0">Enter customer order</h1></div>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/orders/store" class="order-form card card-body shadow-sm border-0">
        <label class="form-label">Customer name <input class="form-control" name="customerName" required maxlength="120"></label>
        <label class="form-label">Phone <input class="form-control" name="customerPhone" required maxlength="40"></label>
        <label class="form-label">Address <textarea class="form-control" name="customerAddress" required maxlength="500"></textarea></label>
        <h2 class="h5 mt-2">Products</h2>
        <% if (products.length) { %>
            <div id="order-items">
                <div class="order-item">
                    <label class="form-label flex-grow-1">Product
                        <select class="form-select" name="productId" required>
                            <% products.forEach(product => { %>
                                <option value="<%= product._id %>"><%= product.name %> — <%= product.price %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label class="form-label">Quantity <input class="form-control" type="number" name="quantity" min="1" step="1" value="1" required></label>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" type="button" id="add-order-item">Add another product</button>
            <button class="btn btn-primary" type="submit">Save order</button></div>
        <% } else { %>
            <p class="alert alert-warning">Add products to the catalog before entering an order.</p>
        <% } %>
        <a class="btn btn-link px-0" href="/orders">Cancel</a>
    </form>
</section>
<script>
    document.getElementById('add-order-item')?.addEventListener('click', () => {
        const first = document.querySelector('.order-item');
        const copy = first.cloneNode(true);
        copy.querySelector('input').value = '1';
        copy.querySelector('select').selectedIndex = 0;
        document.getElementById('order-items').appendChild(copy);
    });
</script>

<%- include('../../partials/siteFooter') %>
