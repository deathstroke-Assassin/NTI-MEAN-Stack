<%- include('../../partials/siteHeader', {pageTitle: "Movies Page" }) %>

    <div class="container py-4">

        <!-- Header
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold">
     <a href="/movies/" style="text-decoration: none;">
                🎬 Movies</h1>
            </a> -->

            <!-- <a href="/movies/createForm" class="btn btn-success">
                + Add New Movie
            </a> -->
        </div>

     
        <section>

            <% if (movies.length> 0 ) { %>
                <div class="row g-4">

                    <section class="searchBar">
                        <form action="/movies/search" method="GET">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search movies..." name="MovieSearchText">

                                <button class="btn btn-outline-secondary" type="submit">
                                    Search
                                </button>
                            </div>
                        </form>
                    </section>
<section>
     <a href="/movies/Categories" class="btn btn-outline-dark">
                Categories
            </a>
             
</section>

                   <% movies.forEach((oneMovie) => { %>

                        <div class="col-md-6 col-lg-4 col-xl-3">

                            <a href="/movies/show/<%= oneMovie._id %>" style="text-decoration: none;">
                            <div class="card h-100 shadow-sm" >
                                           
                                <!-- Thumbnail -->
                                <img src="<%= oneMovie.thumbnail %>" class="card-img-top" alt="<%= oneMovie.title %>"
                                    style="object-fit: cover;" width="<%=oneMovie.thumbnail_width %>"
                                    height="<%=oneMovie.thumbnail_height %>">
                               
                                <div class="card-body d-flex flex-column">

                                    <!-- Title -->
                                    <h5 class="card-title fw-bold">
                                        <%= oneMovie.title %>
                                    </h5>

                                    <!-- Year -->
                                    <strong class="text-muted mb-2">
                                         <%= oneMovie.year %>
                                    </strong>

                                    <!-- Cast -->
                                    <!-- <p class="card-text mb-2">
                                        <strong>Cast:</strong>
                                        <%= oneMovie.cast %>
                                    </p> -->

                                    <!-- Genres -->
                                    <!-- <p class="card-text">
                                        <strong>Genres:</strong>
                                        <%= oneMovie.genres %>
                                    </p> -->

                                    <!-- Operations -->
                                    <div class="mt-auto pt-3 d-flex gap-2">

                                        
<!-- 
                                        <a href="/movies/updateForm/<%= oneMovie._id %>" class="btn btn-warning btn-sm">
                                            Update
                                        </a>

                                        <button onclick="destroy(this);" movieID="<%= oneMovie._id %>"
                                            class="btn btn-danger btn-sm">
                                            Delete
                                        </button> -->

                                    </div>

                                </div>

                            </div>
                                        </a> 

                        </div>

                        <% }); %>

                </div>

                <% } else { %>

                    <div class="alert alert-info text-center">
                        <h4>No movies created yet!</h4>

                        <p class="mb-0">
                            Click "Add New Movie" to create your first movie.
                        </p>
                    </div>

                    <% } %>

        </section>
    </div>






    <script>
        function destroy(obj) {

            if (confirm("Are you sure you want to delete this movie?")) {

                const id = obj.getAttribute("movieID");

                window.location.replace("/movies/destroy/" + id);
            }
        }
    </script>

    <%- include('../../partials/siteFooter') %>