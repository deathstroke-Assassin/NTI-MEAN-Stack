async function store(createFormData) {
  let doc = {};
  doc.productName = createFormData.productName;
  doc.weight = createFormData.weight;
  doc.photo = createFormData.photo;

  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();

  await db.collection("movies").insertOne(doc, function (err, res) {
    if (err) throw err;
    client.close();
    return { operation: "success" };
  });
}

async function update(updateFormData) {
  const id = updateFormData.id;
  const thumbnail = updateFormData.thumbnail;
  const title = updateFormData.title;
  const year = updateFormData.year;
 const cast = updateFormData.cast
        .split(",")
        .map(actor => actor.trim())
        .filter(actor => actor !== "");

    const genres = updateFormData.genres
        .split(",")
        .map(genre => genre.trim())
        .filter(genre => genre !== "");
        
  if (thumbnail != "") {
    var updateQuery = {
      title: title,
      year: year,
      cast: cast,
      genres: genres,
      thumbnail: thumbnail,
    };
  } else {
    var updateQuery = {
     title: title,
      year: year,
      cast: cast,
      genres: genres,
    };
  }

  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();
  await db
    .collection("movies")
    .updateOne(
      { _id: new ObjectId(String(id)) },
      { $set: updateQuery },
      function (err, res) {
        if (err) throw err;

        client.close();

        return { operation: "success" };
      },
    );
}
