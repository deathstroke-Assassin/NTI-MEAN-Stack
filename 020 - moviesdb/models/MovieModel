async function search(MovieSearchText) {
  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();

  const movies = await db
    .collection("movies")
    .find({
      title: {
        $regex: MovieSearchText,
        $options: "i",
      },
    })
    .sort({ year: -1 })
    .limit(20)
    .toArray();

  client.close();

  return movies;
}

async function getCategory(MovieCategory) {
  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();
  const movies = await db.collection("movies")
  .find({
    genres: {
      $regex: MovieCategory,
      $options: 'i'
    }
  })
  .sort({ year: -1 })
    .limit(20)
    .toArray();

  client.close();
  console.log(movies.length);
  return movies;
}

async function show(id) {
  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();
  const movies = await db
    .collection("movies")
    .find({ _id: new ObjectId(String(id)) })
    .toArray();
  client.close();
  return movies;
}

