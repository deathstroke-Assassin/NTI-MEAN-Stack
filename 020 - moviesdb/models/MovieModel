async function index() {
  const client = await MongoClient.connect(mongoConnection);
  const db = client.db();
  // const movies = await db.collection("movies").findOne({ title: "Dog Gone" })
  // const movies = await db.collection("movies").find().limit(60).toArray();
  const movies = await db
